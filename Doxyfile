# Create build/doxygen first, then run from the MicroApp root: doxygen Doxyfile
PROJECT_NAME           = MicroApp
PROJECT_NUMBER         = V0.0.2
PROJECT_BRIEF          = "Independent MCU App SDK, lifecycle and persistent storage"
OUTPUT_DIRECTORY       = build/doxygen
OUTPUT_LANGUAGE        = Chinese
INPUT_ENCODING         = UTF-8
INPUT                  = README.md ARCHITECTURE.md LICENSING.md docs include src examples/counter
FILE_PATTERNS          = *.h *.c *.md
RECURSIVE              = YES
EXCLUDE                = docs/diagrams
USE_MDFILE_AS_MAINPAGE  = README.md
IMAGE_PATH             = docs/diagrams assets
EXTRACT_ALL            = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
OPTIMIZE_OUTPUT_FOR_C  = YES
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = "__attribute__(x)="
MARKDOWN_SUPPORT       = YES
MARKDOWN_STRICT        = YES
JAVADOC_AUTOBRIEF       = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
FULL_PATH_NAMES        = NO
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = YES
HAVE_DOT               = NO
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_LOGFILE           = build/doxygen/warnings.log
