set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(MICROAPP_ARM_FLOAT_ABI hard CACHE STRING "Host Cortex-M4 float ABI: soft, softfp or hard")
set_property(CACHE MICROAPP_ARM_FLOAT_ABI PROPERTY STRINGS soft softfp hard)
if(NOT MICROAPP_ARM_FLOAT_ABI MATCHES "^(soft|softfp|hard)$")
    message(FATAL_ERROR "Invalid MICROAPP_ARM_FLOAT_ABI")
endif()
set(CMAKE_C_FLAGS_INIT "-mcpu=cortex-m4 -mthumb -mfpu=fpv4-sp-d16 -mfloat-abi=${MICROAPP_ARM_FLOAT_ABI}")
set(CMAKE_ASM_FLAGS_INIT "${CMAKE_C_FLAGS_INIT}")
find_program(CMAKE_C_COMPILER arm-none-eabi-gcc REQUIRED)
find_program(CMAKE_ASM_COMPILER arm-none-eabi-gcc REQUIRED)
find_program(CMAKE_SIZE arm-none-eabi-size REQUIRED)
find_program(CMAKE_OBJCOPY arm-none-eabi-objcopy REQUIRED)
